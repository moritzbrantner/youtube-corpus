{
  "schemaVersion": 1,
  "surface": "youtube-video-analyzer",
  "delivery": "static-github-pages",
  "input": "youtube-video-url",
  "browser": {
    "owns": [
      "youtube-url-validation",
      "canonical-video-url",
      "privacy-enhanced-preview",
      "analysis-report-rendering"
    ],
    "doesNotOwn": [
      "youtube-media-download",
      "youtube-caption-download",
      "transcript-persistence",
      "nlp-semantics"
    ]
  },
  "backend": {
    "defaultPagesUrl": "http://127.0.0.1:1420",
    "requiredForFullAnalysis": true,
    "operations": [
      "yt-dlp-metadata",
      "manual-and-auto-caption-ingest",
      "transcript-normalization-and-indexing",
      "text-lexical-analysis",
      "optional-whisper-asr",
      "available-multimodal-evidence"
    ]
  },
  "transcriptPreference": ["caption_manual", "caption_auto", "asr"],
  "analysis": {
    "metadata": "available-after-ingest",
    "transcript": "available-when-captions-or-asr-exist",
    "lexical": "deterministic-text-lexical",
    "visualTimeline": "reported-only-when-evidence-exists",
    "audioFeatures": "reported-only-when-evidence-exists"
  },
  "privacy": {
    "staticSiteStoresMedia": false,
    "previewHost": "youtube-nocookie.com",
    "backendPersistence": "configured-youtube-corpus-work-directory-and-postgres"
  }
}

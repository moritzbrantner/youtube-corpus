    {
      "id": "5e000000-0000-4000-8000-0000000000c0",
      "sourceId": "0a200000-0000-4000-8000-000000000002",
      "sequence": 0,
      "text": "so the question is what being means",
      "contentHash": "sha256:6928f1c1f8acfe5cc2b8e7ad15b286e1e2d908fd7447b6e8471492bac3ace413",
      "language": "en",
      "locator": {
        "kind": "timed",
        "segmentIndex": 0,
        "startSeconds": 0.0,
        "endSeconds": 3.125
      },
      "metadata": {
        "streamId": "0a200000-0000-4000-8000-000000000002",
        "transcriptSource": "asr",
        "videoId": "11111111-1111-4111-8111-111111111111"
      }
    },
    {
      "id": "5e000000-0000-4000-8000-0000000000c1",
      "sourceId": "0a200000-0000-4000-8000-000000000002",
      "sequence": 1,
      "text": "essence comes first",
      "contentHash": "sha256:ff1b8012b02cb5b756d019bb19e25c6268999cde61ee5f36f2c27f83c3a2856e",
      "language": "en",
      "locator": {
        "kind": "timed",
        "segmentIndex": 1,
        "startSeconds": 3.125,
        "endSeconds": 6.0
      },
      "metadata": {
        "streamId": "0a200000-0000-4000-8000-000000000002",
        "transcriptSource": "asr",
        "videoId": "11111111-1111-4111-8111-111111111111"
      }
    },
    {
      "id": "5e000000-0000-4000-8000-0000000000c2",
      "sourceId": "0a200000-0000-4000-8000-000000000002",
      "sequence": 2,
      "text": "and existence follows.",
      "contentHash": "sha256:fd3b630e1005321c43deaf027e6991cbfd3b8b34c62cb0c99a1076ed71319b04",
      "language": "en",
      "locator": {
        "kind": "timed",
        "segmentIndex": 2,
        "startSeconds": 6.0
      },
      "metadata": {
        "streamId": "0a200000-0000-4000-8000-000000000002",
        "transcriptSource": "asr",
        "videoId": "11111111-1111-4111-8111-111111111111"
      }
    },
    {
      "id": "5e000000-0000-4000-8000-0000000000a0",
      "sourceId": "a1000000-0000-4000-8000-000000000001",
      "sequence": 0,
      "text": "First claim about being.",
      "contentHash": "sha256:50c09da6c4880b14e719f243093b142029c05728971923fe9f6957b5f516da62",
      "language": "en",
      "locator": {
        "kind": "timed",
        "segmentIndex": 0,
        "startSeconds": 0.0,
        "endSeconds": 2.5
      },
      "metadata": {
        "streamId": "a1000000-0000-4000-8000-000000000001",
        "transcriptSource": "caption_manual",
        "videoId": "11111111-1111-4111-8111-111111111111"
      }
    },
    {
      "id": "5e000000-0000-4000-8000-0000000000a1",
      "sourceId": "a1000000-0000-4000-8000-000000000001",
      "sequence": 1,
      "text": "Second claim: essence ≠ existence.",
      "contentHash": "sha256:f807573ce075a98de6a8e6eb8ceae2142f64b4839d65e8da9440a1bd4dac46e1",
      "language": "en",
      "locator": {
        "kind": "timed",
        "segmentIndex": 1,
        "startSeconds": 2.5,
        "endSeconds": 5.25
      },
      "metadata": {
        "streamId": "a1000000-0000-4000-8000-000000000001",
        "transcriptSource": "caption_manual",
        "videoId": "11111111-1111-4111-8111-111111111111"
      }
    },
    {

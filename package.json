{
  "name": "youtube-corpus-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-postgres://postgres:postgres@localhost:5432/youtube_corpus} cargo run -- migrate",
    "dev": "bun run build && DATABASE_URL=${DATABASE_URL:-postgres://postgres:postgres@localhost:5432/youtube_corpus} cargo run",
    "dev:frontend": "bun run build:wasm && vite",
    "captions:bridge": "cargo run -- --no-open",
    "build:wasm": "wasm-pack build crates/youtube-browser-wasm --target web --release --out-dir ../../src/app/features/analyzer/wasm --out-name youtube_browser_wasm",
    "build": "bun run build:wasm && bun run build:prepared",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preview": "vite preview",
    "test:browser-wasm": "cargo test --manifest-path crates/youtube-browser-wasm/Cargo.toml",
    "test:frontend": "bun test tests/frontend",
    "test:e2e": "playwright test --workers=2",
    "validate": "bun run verify:fast",
    "verify:fast": "bun run format:check && bun run test:browser-wasm && bun run test:frontend && bun run build && cargo fmt --check && cargo check && cargo clippy --all-targets -- -D warnings && cargo test",
    "verify:postgres": "bash ./scripts/verify-postgres.sh",
    "verify:yt-dlp": "cargo test --test yt_dlp_integration -- --ignored",
    "verify:release": "bun run verify:fast && bun run verify:postgres",
    "verify:ci": "bun run verify:release",
    "verify": "bun run verify:release",
    "build:prepared": "tsc && vite build",
    "start": "bash scripts/start.sh",
    "verify:startup": "bun test tests/startup.test.ts --timeout 300000"
  },
  "dependencies": {
    "@moenarch/editor-core": "git+https://github.com/moritzbrantner/editor-core.git#d00922c389810a20581c8424363920da3927c70f",
    "@moritzbrantner/graph-editor": "git+https://github.com/moritzbrantner/graph-editor.git#7b47e979ae991011d1020bd7cf24e810d6e8bef4",
    "@moritzbrantner/ui": "1.1.0",
    "@moritzbrantner/workflow-editor": "git+https://github.com/moritzbrantner/workflow-editor.git#14bb3bdc5e796e52f824010eaeb32527a1f282f9",
    "@tanstack/react-query": "^5.100.6",
    "lucide-react": "^1.7.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "oxfmt": "0.76.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "trustedDependencies": [
    "@moenarch/editor-core",
    "@moritzbrantner/graph-editor",
    "@moritzbrantner/workflow-editor"
  ]
}
